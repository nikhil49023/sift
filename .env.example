NODE_ENV=development
AUTH_MODE=local
DATABASE_URL=postgres://sift:sift@localhost:55432/sift
REDIS_URL=redis://localhost:56379
CORS_ORIGIN=http://localhost:5173
# Supply these locally; never put provider secrets in frontend VITE_ variables.
GITHUB_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RANKINGS_ENABLED=false
DATASET_LICENSE_APPROVED=false
# Production requires AUTH_MODE=supabase and these values:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SECRET_KEY=
# STORAGE_BUCKET=sift-private
