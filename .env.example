NODE_ENV=development
AUTH_MODE=local
DATABASE_URL=postgres://sift:sift@localhost:55432/sift
REDIS_URL=redis://localhost:56379
CORS_ORIGIN=http://localhost:5173
# Supply these locally; never put provider secrets in frontend VITE_ variables.
GITHUB_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Source-content characters, not exact tokens. Tune to Groq account quotas.
JUDGE_MAX_EVIDENCE_CHARS=16000
JUDGE_MAX_OUTPUT_TOKENS=4096
# Optional TypeSafe Jev verification. A key alone does not enable API spending.
# Set DECISION_PROVIDER=typesafe only with an account credit balance.
DECISION_PROVIDER=none
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_SUPPORT_THRESHOLD=0.8
JEV_MAX_REQUEST_CHARS=64000
RANKINGS_ENABLED=false
DATASET_LICENSE_APPROVED=false
# Production requires AUTH_MODE=supabase and these values:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SECRET_KEY=
# DATABASE_CA_BASE64=base64-encoded-database-root-certificate
# Use the Supabase session connection URL, without SSL query parameters.
# STORAGE_BUCKET=sift-private
