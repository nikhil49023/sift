{
  "name": "sift", "private": true, "type": "module",
  "workspaces": ["shared", "backend", "frontend"],
  "scripts": {
    "dev": "npm run dev -w backend",
    "dev:ui": "npm run dev -w frontend",
    "worker": "npm run worker -w backend",
    "migrate": "npm run migrate -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "check": "npm run build && npm test"
  },
  "engines": {"node": ">=22"}
}
